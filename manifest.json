{
  "manifest_version": 3,
  "name": "ChatGPT Audio Downloader",
  "version": "3.0.0",
  "description": "Save ChatGPT Read Aloud audio directly from the stream, with progress and playback-independent full downloads.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatGPT Audio Downloader",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "capture-core.js",
        "inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_start"
    }
  ],
  "minimum_chrome_version": "111"
}
